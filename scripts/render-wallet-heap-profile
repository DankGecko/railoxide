#!/usr/bin/env python3

import argparse
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path


MAPPING_PATTERN = re.compile(r"^([0-9a-fA-F]+)-([0-9a-fA-F]+): (.+)$")


def require_tool(name: str) -> str:
    path = shutil.which(name)
    if path is None:
        raise RuntimeError(f"required tool not found: {name}")
    return path


def macho_text_base(binary: Path) -> int:
    if shutil.which("otool") is not None:
        command = ["otool", "-l", str(binary)]
    else:
        command = [
            require_tool("llvm-objdump"),
            "--macho",
            "--private-headers",
            str(binary),
        ]
    output = subprocess.check_output(command, text=True)
    lines = output.splitlines()
    for index, line in enumerate(lines):
        if line.strip() != "segname __TEXT":
            continue
        for candidate in lines[index + 1 : index + 8]:
            fields = candidate.split()
            if len(fields) == 2 and fields[0] == "vmaddr":
                return int(fields[1], 16)
    raise RuntimeError(f"could not determine Mach-O __TEXT base for {binary}")


def executable_mapping(lines: list[str], binary: Path) -> tuple[int, int, int]:
    mappings_start = next(
        (index for index, line in enumerate(lines) if line == "MAPPED_LIBRARIES:"),
        None,
    )
    if mappings_start is None:
        raise RuntimeError("jemalloc profile has no MAPPED_LIBRARIES section")

    matches = []
    for index in range(mappings_start + 1, len(lines)):
        match = MAPPING_PATTERN.match(lines[index])
        if match is None or Path(match.group(3)).name != binary.name:
            continue
        matches.append((index, int(match.group(1), 16), int(match.group(2), 16)))
    if len(matches) != 1:
        raise RuntimeError(
            f"expected one mapping named {binary.name!r}, found {len(matches)}"
        )
    return matches[0]


def rebase_profile(profile: Path, binary: Path, destination: Path) -> int:
    lines = profile.read_text(encoding="utf-8").splitlines()
    if not lines or not lines[0].startswith("heap_v2/"):
        raise RuntimeError(f"unsupported jemalloc profile format in {profile}")

    mapping_index, runtime_start, runtime_end = executable_mapping(lines, binary)
    preferred_start = macho_text_base(binary)
    slide = runtime_start - preferred_start

    for index, line in enumerate(lines):
        if not line.startswith("@ "):
            continue
        rebased = []
        for value in line[2:].split():
            address = int(value, 16)
            if runtime_start <= address < runtime_end:
                address -= slide
            rebased.append(f"0x{address:x}")
        lines[index] = "@ " + " ".join(rebased)

    preferred_end = preferred_start + (runtime_end - runtime_start)
    lines[mapping_index] = (
        f"{preferred_start:016x}-{preferred_end:016x}: {binary.resolve()}"
    )
    destination.write_text("\n".join(lines) + "\n", encoding="utf-8")
    return slide


def render_flamegraph(profile: Path, binary: Path, output: Path) -> int:
    jeprof = require_tool("jeprof")
    rustfilt = require_tool("rustfilt")
    inferno = require_tool("inferno-flamegraph")
    with tempfile.TemporaryDirectory(prefix="railoxide-heap-") as temp_dir:
        rebased_profile = Path(temp_dir) / "rebased.heap"
        slide = rebase_profile(profile, binary, rebased_profile)
        collapsed = subprocess.check_output(
            [
                jeprof,
                "--show_bytes",
                "--collapsed",
                str(binary),
                str(rebased_profile),
            ]
        )
        demangled = subprocess.check_output([rustfilt], input=collapsed)
        with output.open("wb") as output_file:
            subprocess.run(
                [inferno, "--countname", "bytes"],
                input=demangled,
                stdout=output_file,
                check=True,
            )
    return slide


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Render an ASLR-correct jemalloc heap flamegraph for RailOxide"
    )
    parser.add_argument("--profile", required=True, type=Path)
    parser.add_argument("--binary", required=True, type=Path)
    parser.add_argument("--output", required=True, type=Path)
    args = parser.parse_args()

    for path in (args.profile, args.binary):
        if not path.is_file():
            parser.error(f"file does not exist: {path}")
    if not args.output.parent.is_dir():
        parser.error(f"output directory does not exist: {args.output.parent}")

    try:
        slide = render_flamegraph(args.profile, args.binary, args.output)
    except (OSError, RuntimeError, subprocess.CalledProcessError, ValueError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 1

    print(f"ASLR slide: 0x{slide:x}")
    print(f"wrote {args.output}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
