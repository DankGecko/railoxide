<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.triamazikamno.RailOxide</id>
  <name>RailOxide</name>
  <summary>Desktop wallet for private RAILGUN transactions</summary>
  <developer id="io.github.triamazikamno">
    <name>RailOxide contributors</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <description>
    <p>
      RailOxide is a desktop wallet for preparing private RAILGUN transactions,
      managing public accounts, and connecting applications through WalletConnect.
    </p>
    <p>
      RailOxide is alpha software. Verify transaction details independently and
      use it only with funds you can afford to lose.
    </p>
  </description>
  <launchable type="desktop-id">io.github.triamazikamno.RailOxide.desktop</launchable>
  <provides>
    <binary>io.github.triamazikamno.RailOxide</binary>
  </provides>
  <url type="homepage">https://github.com/triamazikamno/railoxide</url>
  <url type="bugtracker">https://github.com/triamazikamno/railoxide/issues</url>
  <releases>
    <release version="@VERSION@" date="@DATE@" type="@RELEASE_TYPE@" />
  </releases>
  <content_rating type="oars-1.1" />
</component>
